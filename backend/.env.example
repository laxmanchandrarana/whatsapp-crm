DEBUG=True
SECRET_KEY=django-insecure-whatsapp-crm-key-change-in-production
ALLOWED_HOSTS=*

# Database (defaults to SQLite if not provided)
# DATABASE_URL=postgres://user:password@localhost:5432/whatsapp_crm

# Celery & Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Meta WhatsApp Cloud API credentials
WHATSAPP_API_TOKEN=your_meta_system_user_or_user_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id
WHATSAPP_VERIFY_TOKEN=openmausbot_crm_verify_token_secure
WHATSAPP_APP_SECRET=your_meta_app_secret
WHATSAPP_API_VERSION=v20.0
# Set to True to simulate Meta Cloud API calls without live credentials
WHATSAPP_SIMULATE_OUTBOUND=True

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
